{
  "manifest_version": 3,
  "name": "CheckFirst: scam and fake-link checker",
  "short_name": "CheckFirst",
  "version": "0.3.0",
  "description": "Right-click a link, selected text or page and check it for scam signs. Runs on your device first, with a cloud fallback.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://firebasevertexai.googleapis.com/*",
    "https://content-firebaseappcheck.googleapis.com/*",
    "https://firebaseappcheck.googleapis.com/*",
    "https://firebaseinstallations.googleapis.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CheckFirst",
    "default_popup": "result.html"
  },
  "key": ""
}
