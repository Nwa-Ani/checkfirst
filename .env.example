# Copy to .env.local (never commit it). Values come from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check. Local dev: set DEBUG=true and register the debug token printed in the browser console.
VITE_APPCHECK_DEBUG=true
# Local only. Never used in production builds (Vite strips it).
VITE_APPCHECK_DEBUG_TOKEN=
# Production (hosted demo): reCAPTCHA Enterprise site key for App Check. Site key is limited to localhost until a hosted domain is added.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional cloud model override (default is the SDK default cloud model).
VITE_CLOUD_MODEL=
# Public site URL used by the extension "Open full check" button (fragment only).
VITE_PUBLIC_SITE_URL=http://127.0.0.1:5173
# Production extension: helper that mints App Check tokens (CustomProvider).
VITE_APPCHECK_TOKEN_URL=

# Helper used for App Check tokens (extension) and website Safe Browsing checks.
# Local default is the helper on port 8787. Production: https://checkfirst-appcheck.onrender.com
VITE_APPCHECK_TOKEN_URL=http://127.0.0.1:8787/appcheck-token
VITE_HELPER_URL=
